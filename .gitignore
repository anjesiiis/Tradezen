# Chave privada e certificado: nada disto entra no repositorio. Nunca
# entrou (conferido com git log --all --full-history), e estas linhas
# existem pra que um arquivo desses nao passe por um `git add .` distraido.
*.key
*.pem

# Credencial e cache do deploy local da Vercel
.vercel/

frontend/node_modules/
frontend/dist/

.DS_Store
detectar_e_salvar.log

# Modelos treinados: o .pkl em disco e CACHE, nao a fonte. O original fica
# em modelos_treinados.modelo_b64 no Supabase (ver 030 e ml/bandeira/
# storage.py), porque o disco do Render morre a cada deploy. Versionar
# binario de 100 arvores a cada treino encheria o repositorio de arquivos
# que ninguem le num diff.
backend/ml/bandeira/modelos/*.pkl
